<Window x:Class="WorldGenerator.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="World Forge"
        Width="1320"
        Height="820"
        MinWidth="960"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        FontFamily="Bahnschrift">
    <Window.Resources>
        <LinearGradientBrush x:Key="WindowBackground" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#EEF4F0" Offset="0" />
            <GradientStop Color="#F8F8F5" Offset="1" />
        </LinearGradientBrush>
        <SolidColorBrush x:Key="PanelBackground" Color="#FFFFFF" />
        <SolidColorBrush x:Key="PanelBorder" Color="#D6E0D7" />
        <SolidColorBrush x:Key="PrimaryText" Color="#18352E" />
        <SolidColorBrush x:Key="MutedText" Color="#61746D" />
        <SolidColorBrush x:Key="Accent" Color="#D75A32" />
        <SolidColorBrush x:Key="AccentHover" Color="#B94522" />

        <Style x:Key="SectionHeading" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedText}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,22,0,10" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource PrimaryText}" />
            <Setter Property="Background" Value="#F7FAF7" />
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="FontSize" Value="14" />
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{StaticResource Accent}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="14,11" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource AccentHover}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource PrimaryText}" />
            <Setter Property="Background" Value="#EDF4EE" />
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#DDEBDD" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource WindowBackground}" Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="56" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Background="{StaticResource PanelBackground}"
                BorderBrush="{StaticResource PanelBorder}"
                BorderThickness="1"
                CornerRadius="8">
            <Grid Margin="22,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="10" Height="10" Background="{StaticResource Accent}" CornerRadius="5" Margin="0,0,10,0" />
                    <TextBlock Text="WORLD FORGE"
                               Foreground="{StaticResource PrimaryText}"
                               FontSize="19"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Fill="#55A868" Margin="0,0,8,0" />
                    <TextBlock x:Name="StatusText"
                               Text="READY"
                               Foreground="{StaticResource MutedText}"
                               FontSize="12"
                               FontWeight="SemiBold" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="310" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{StaticResource PanelBackground}"
                    BorderBrush="{StaticResource PanelBorder}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="24">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="CONFIGURATION"
                                   Foreground="{StaticResource PrimaryText}"
                                   FontSize="18"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="Tune the map before its next generation."
                                   Foreground="{StaticResource MutedText}"
                                   FontSize="13"
                                   Margin="0,5,0,0" />

                        <TextBlock Text="DIMENSIONS" Style="{StaticResource SectionHeading}" />

                        <TextBlock Text="Width" Foreground="{StaticResource PrimaryText}" FontSize="13" />
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="46" />
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="WidthSlider"
                                    Minimum="64"
                                    Maximum="4096"
                                    Value="256"
                                    TickFrequency="64"
                                    IsSnapToTickEnabled="True"
                                    SmallChange="64"
                                    LargeChange="256"
                                    ValueChanged="SettingsSlider_ValueChanged"
                                    VerticalAlignment="Center" />
                            <TextBlock x:Name="WidthValue"
                                       Grid.Column="1"
                                       Text="256"
                                       Foreground="{StaticResource PrimaryText}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center" />
                        </Grid>

                        <TextBlock Text="Height" Foreground="{StaticResource PrimaryText}" FontSize="13" Margin="0,16,0,0" />
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="46" />
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="HeightSlider"
                                    Minimum="64"
                                    Maximum="4096"
                                    Value="256"
                                    TickFrequency="64"
                                    IsSnapToTickEnabled="True"
                                    SmallChange="64"
                                    LargeChange="256"
                                    ValueChanged="SettingsSlider_ValueChanged"
                                    VerticalAlignment="Center" />
                            <TextBlock x:Name="HeightValue"
                                       Grid.Column="1"
                                       Text="256"
                                       Foreground="{StaticResource PrimaryText}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center" />
                        </Grid>

                        <TextBlock Text="BIOME DIVERSITY" Style="{StaticResource SectionHeading}" />

                        <TextBlock Text="Minimum biomes" Foreground="{StaticResource PrimaryText}" FontSize="13" />
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="46" />
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="MinSeedsSlider"
                                    Minimum="1"
                                    Maximum="49"
                                    Value="5"
                                    TickFrequency="1"
                                    IsSnapToTickEnabled="True"
                                    ValueChanged="SettingsSlider_ValueChanged"
                                    VerticalAlignment="Center" />
                            <TextBlock x:Name="MinSeedsValue"
                                       Grid.Column="1"
                                       Text="5"
                                       Foreground="{StaticResource PrimaryText}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center" />
                        </Grid>

                        <TextBlock Text="Maximum biomes" Foreground="{StaticResource PrimaryText}" FontSize="13" Margin="0,16,0,0" />
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="46" />
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="MaxSeedsSlider"
                                    Minimum="1"
                                    Maximum="49"
                                    Value="10"
                                    TickFrequency="1"
                                    IsSnapToTickEnabled="True"
                                    ValueChanged="SettingsSlider_ValueChanged"
                                    VerticalAlignment="Center" />
                            <TextBlock x:Name="MaxSeedsValue"
                                       Grid.Column="1"
                                       Text="10"
                                       Foreground="{StaticResource PrimaryText}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center" />
                        </Grid>

                        <TextBlock Text="SMOOTHING" Style="{StaticResource SectionHeading}" />
                        <TextBlock Text="Passes" Foreground="{StaticResource PrimaryText}" FontSize="13" />
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="46" />
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="SmoothingPassesSlider"
                                    Minimum="0"
                                    Maximum="20"
                                    Value="2"
                                    TickFrequency="1"
                                    IsSnapToTickEnabled="True"
                                    ValueChanged="SettingsSlider_ValueChanged"
                                    VerticalAlignment="Center" />
                            <TextBlock x:Name="SmoothingPassesValue"
                                       Grid.Column="1"
                                       Text="2"
                                       Foreground="{StaticResource PrimaryText}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center" />
                        </Grid>

                        <TextBlock Text="Boundary variation" Foreground="{StaticResource PrimaryText}" FontSize="13" Margin="0,16,0,0" />
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="46" />
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="BiomeVariationSlider"
                                    Minimum="0"
                                    Maximum="0.5"
                                    Value="0.15"
                                    TickFrequency="0.05"
                                    IsSnapToTickEnabled="True"
                                    ValueChanged="SettingsSlider_ValueChanged"
                                    VerticalAlignment="Center" />
                            <TextBlock x:Name="BiomeVariationValue"
                                       Grid.Column="1"
                                       Text="15%"
                                       Foreground="{StaticResource PrimaryText}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center" />
                        </Grid>

                        <TextBlock Text="RANDOMNESS" Style="{StaticResource SectionHeading}" />
                        <TextBlock Text="Seed" Foreground="{StaticResource PrimaryText}" FontSize="13" />
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="88" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="SeedTextBox"
                                     MaxLength="10"
                                     ToolTip="Leave blank for a new random world" />
                            <Button Grid.Column="1"
                                    Content="Randomize"
                                    Style="{StaticResource SecondaryButton}"
                                    Margin="8,0,0,0"
                                    Click="RandomizeSeed_Click"
                                    ToolTip="Choose a random reproducible seed" />
                        </Grid>

                        <TextBlock x:Name="ErrorText"
                                   Foreground="#B42318"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Margin="0,12,0,0"
                                   Visibility="Collapsed" />

                        <Button x:Name="GenerateWorldButton"
                            Content="Generate world"
                                Style="{StaticResource PrimaryButton}"
                                Margin="0,24,0,0"
                                Click="GenerateWorld_Click" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="WORLD PREVIEW"
                               Foreground="{StaticResource PrimaryText}"
                               FontSize="18"
                               FontWeight="SemiBold" />
                    <TextBlock x:Name="HoveredBiomeText"
                               Grid.Column="1"
                               Text="BIOME: -"
                               Foreground="{StaticResource PrimaryText}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Margin="0,0,18,0" />
                    <TextBlock x:Name="MapSizeText"
                               Grid.Column="2"
                               Text="100 x 100 TILES"
                               Foreground="{StaticResource MutedText}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                </Grid>

                <Border Grid.Row="1"
                        Background="#16271F"
                        BorderBrush="#244236"
                        BorderThickness="1"
                        CornerRadius="8"
                        Margin="0,12,0,12"
                        Padding="18">
                    <Grid>
                        <Image x:Name="WorldMapImage"
                               Stretch="Uniform"
                               Cursor="Cross"
                               SnapsToDevicePixels="True"
                               RenderOptions.BitmapScalingMode="NearestNeighbor"
                               MouseMove="WorldMapImage_MouseMove"
                               MouseLeave="WorldMapImage_MouseLeave" />
                    </Grid>
                </Border>

                <Border Grid.Row="2"
                        Background="{StaticResource PanelBackground}"
                        BorderBrush="{StaticResource PanelBorder}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16,12">
                    <TextBlock x:Name="GenerationSummary"
                               Text="Loading the initial world..."
                               Foreground="{StaticResource MutedText}"
                               FontSize="13" />
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
