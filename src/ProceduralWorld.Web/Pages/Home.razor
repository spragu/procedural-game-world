@page "/"
@implements IAsyncDisposable
@inject IJSRuntime JS

<PageTitle>Procedural World Atlas</PageTitle>

<div class="shell">
    <aside class="sidebar">
        <h1>Procedural World Atlas</h1>
        <p class="subtitle">Ocean rim outward, danger inward. Hover any tile for details.</p>

        <div class="field">
            <label>World size</label>
            <select value="@_sizePreset" @onchange="OnSizePresetChanged">
                @foreach (var preset in SizePresets)
                {
                    <option value="@preset.Key">@preset.Label</option>
                }
                <option value="custom">Custom…</option>
            </select>
        </div>

        @if (_sizePreset == "custom")
        {
            <div class="field-pair">
                <div class="field">
                    <label>Width</label>
                    <input type="number" min="16" max="4096" step="16" @bind="_width" />
                </div>
                <div class="field">
                    <label>Height</label>
                    <input type="number" min="16" max="4096" step="16" @bind="_height" />
                </div>
            </div>
        }

        <p class="hint @(_estimatedMb > 600 ? "warn" : null)">
            @($"{(long)_width * _height:N0}") tiles · ~@_estimatedMb.ToString("N0") MB
            @if (_estimatedMb > 600)
            {
                <text> · heavy, expect a pause</text>
            }
        </p>

        <div class="field">
            <label>Seed <span class="value">@_seed</span></label>
            <input type="number" @bind="_seed" @bind:event="oninput" />
        </div>

        <div class="field">
            <label>Landmass shape</label>
            <select @bind="_shape">
                @foreach (var shape in Enum.GetValues<ContinentShape>())
                {
                    <option value="@shape">@shape</option>
                }
            </select>
        </div>

        <div class="field">
            <label>Ocean rim <span class="value">@_oceanRim.ToString("0.00")</span></label>
            <input type="range" min="0" max="0.45" step="0.01" @bind="_oceanRim" @bind:event="oninput" />
        </div>

        <div class="field">
            <label>Sea level <span class="value">@_seaLevel.ToString("0.00")</span></label>
            <input type="range" min="0.20" max="0.70" step="0.01" @bind="_seaLevel" @bind:event="oninput" />
        </div>

        <div class="field">
            <label>Terrain scale <span class="value">@_terrainScale.ToString("0.0")</span></label>
            <input type="range" min="0.5" max="8" step="0.1" @bind="_terrainScale" @bind:event="oninput" />
        </div>

        <div class="field">
            <label>Mountains <span class="value">@_mountains.ToString("0.00")</span></label>
            <input type="range" min="0" max="1" step="0.02" @bind="_mountains" @bind:event="oninput" />
        </div>

        <div class="field">
            <label>Coast warp <span class="value">@_coastWarp.ToString("0.00")</span></label>
            <input type="range" min="0" max="0.8" step="0.02" @bind="_coastWarp" @bind:event="oninput" />
        </div>

        <div class="field">
            <label>Transition softness <span class="value">@_softness.ToString("0.000")</span></label>
            <input type="range" min="0" max="0.16" step="0.005" @bind="_softness" @bind:event="oninput" />
        </div>

        <div class="divider"></div>
        <div class="section-title">Difficulty gradient</div>

        <div class="field">
            <label>Strength <span class="value">@_difficulty.ToString("0.00")</span></label>
            <input type="range" min="0" max="1" step="0.02" @bind="_difficulty" @bind:event="oninput" />
        </div>

        <div class="field">
            <label>Curve <span class="value">@_difficultyCurve.ToString("0.00")</span></label>
            <input type="range" min="0.5" max="4" step="0.05" @bind="_difficultyCurve" @bind:event="oninput" />
        </div>

        <div class="field">
            <label>Zone irregularity <span class="value">@_difficultyWarp.ToString("0.00")</span></label>
            <input type="range" min="0" max="1" step="0.02" @bind="_difficultyWarp" @bind:event="oninput" />
        </div>

        <div class="field">
            <label>
                Rivers <span class="value">@_rivers</span>
            </label>
            <input type="range" min="0" max="160" step="1" @bind="_rivers" @bind:event="oninput" />
            <p class="hint">Target count stays constant across map sizes.</p>
        </div>

        <div class="divider"></div>

        <label class="checkbox">
            <input type="checkbox" @bind="_relief" /> Hillshading
        </label>
        <label class="checkbox">
            <input type="checkbox" @bind="_dangerTint" /> Danger tint
        </label>
        <label class="checkbox">
            <input type="checkbox" @bind="_coastline" /> Coastline outline
        </label>

        <div class="buttons">
            <button @onclick="RandomizeAsync" disabled="@_busy">Randomise</button>
            <button class="secondary" @onclick="RegenerateAsync" disabled="@_busy">Rebuild</button>
        </div>

        @if (_biomeShares.Count > 0)
        {
            <div class="divider"></div>
            <div class="section-title">Biome coverage</div>
            <div class="legend">
                @foreach (var (id, share) in _biomeShares)
                {
                    var info = Biomes.Get(id);
                    <div class="legend-row">
                        <span class="swatch" style="background:@BiomePalette.HexOf(id)"></span>
                        <span>@info.Name</span>
                        <span class="pct">@((share * 100f).ToString("0.0"))%</span>
                    </div>
                }
            </div>
        }

        @if (_dangerShares.Count > 0)
        {
            <div class="divider"></div>
            <div class="section-title">Difficulty bands</div>
            <div class="legend">
                @foreach (var (tier, share) in _dangerShares)
                {
                    <div class="legend-row">
                        <span class="swatch" style="background:@BiomePalette.DangerColor(tier).ToHex()"></span>
                        <span>@DangerScale.Label(tier)</span>
                        <span class="pct">@((share * 100f).ToString("0.0"))%</span>
                    </div>
                }
            </div>
        }
    </aside>

    <main class="stage">
        <div class="toolbar">
            <div class="tabs">
                @foreach (var view in Enum.GetValues<MapView>())
                {
                    <button class="@(view == _view ? "active" : null)" @onclick="() => SetViewAsync(view)">@view</button>
                }
            </div>

            <div class="tabs">
                @foreach (var z in ZoomLevels)
                {
                    <button class="@(z == _zoom ? "active" : null)" @onclick="() => SetZoomAsync(z)">@ZoomLabel(z)</button>
                }
            </div>

            @if (_map is { } m && _stride > 1)
            {
                <span class="badge" title="The map is larger than the canvas, so every @_stride-th tile is drawn.">
                    1:@_stride overview
                </span>
            }

            <span class="status">
                @if (_busy)
                {
                    <text>@_busyMessage</text>
                }
                else if (_map is not null)
                {
                    <text>
                        @_map.Width × @_map.Height · seed @_seed ·
                        generated @_generationMs ms · drawn @_renderMs ms ·
                        @_diagnostics
                    </text>
                }
            </span>
        </div>

        <div class="canvas-wrap">
            <canvas @ref="_canvas"
                    @onmousemove="OnMouseMove"
                    @onmouseleave="OnMouseLeave"></canvas>

            @if (_hover is { } hover)
            {
                var info = Biomes.Get(hover.Biome);
                <div class="tooltip" style="left:@(_tooltipX)px; top:@(_tooltipY)px">
                    <div class="name">
                        <span class="swatch" style="background:@BiomePalette.HexOf(hover.Biome)"></span>
                        @info.Name
                        <span class="danger-pill" style="background:@BiomePalette.DangerColor(hover.Tier).ToHex()">
                            @DangerScale.Label(hover.Tier)
                        </span>
                    </div>
                    <div class="desc">@info.Description</div>
                    <dl>
                        <dt>Tile</dt><dd>@_hoverX, @_hoverY</dd>
                        <dt>Suggested level</dt><dd>@hover.SuggestedLevel</dd>
                        <dt>Elevation</dt><dd>@ElevationLabel(hover)</dd>
                        <dt>Temperature</dt><dd>@((hover.Temperature * 100f).ToString("0"))%</dd>
                        <dt>Moisture</dt><dd>@((hover.Moisture * 100f).ToString("0"))%</dd>
                        <dt>Shore distance</dt><dd>@hover.ShoreDistance.ToString("0") tiles</dd>
                        <dt>Passable</dt><dd>@(info.IsPassable ? "yes" : "no")</dd>
                    </dl>
                </div>
            }
        </div>
    </main>
</div>

@code {
    private sealed record SizePreset(string Key, string Label, int Width, int Height);

    private static readonly SizePreset[] SizePresets =
    [
        new("512x320", "512 × 320 — Small", 512, 320),
        new("1024x640", "1024 × 640 — Medium", 1024, 640),
        new("1024x1024", "1024 × 1024 — Square", 1024, 1024),
        new("2048x2048", "2048 × 2048 — Large", 2048, 2048),
        new("3072x3072", "3072 × 3072 — Huge", 3072, 3072),
        new("4096x4096", "4096 × 4096 — Extra large", 4096, 4096),
    ];

    // Negative values mean "fit to canvas at this detail level"; positive values are
    // literal pixel-per-tile magnification for maps small enough to zoom into.
    private static readonly int[] ZoomLevels = [-1, -2, 1, 2, 4];

    /// <summary>Largest canvas edge we are willing to push to the DOM, in pixels.</summary>
    private const int MaxCanvasEdge = 1400;

    private ElementReference _canvas;
    private IJSObjectReference? _module;
    private WorldMap? _map;

    private string _sizePreset = "512x320";
    private int _width = 512;
    private int _height = 320;

    private int _seed = 1337;
    private ContinentShape _shape = ContinentShape.Continent;
    private float _oceanRim = 0.18f;
    private float _seaLevel = 0.42f;
    private float _terrainScale = 2.6f;
    private float _mountains = 0.42f;
    private float _coastWarp = 0.34f;
    private float _softness = 0.055f;
    private float _difficulty = 0.85f;
    private float _difficultyCurve = 1.6f;
    private float _difficultyWarp = 0.28f;
    private int _rivers = 42;

    private bool _relief = true;
    private bool _dangerTint = true;
    private bool _coastline = true;

    private MapView _view = MapView.Biome;
    private int _zoom = -1;
    private bool _busy;
    private string _busyMessage = "Generating…";
    private long _generationMs;
    private long _renderMs;
    private string _diagnostics = "";

    // Mapping from canvas pixels back to tile coordinates.
    private int _stride = 1;
    private int _regionX;
    private int _regionY;
    private double _displayScale = 1;

    private WorldTile? _hover;
    private int _hoverX;
    private int _hoverY;
    private double _tooltipX;
    private double _tooltipY;

    private List<KeyValuePair<BiomeId, float>> _biomeShares = [];
    private List<KeyValuePair<DangerTier, float>> _dangerShares = [];

    /// <summary>Rough peak managed footprint, used to warn before a heavy build.</summary>
    private double _estimatedMb => (long)_width * _height * 32.0 / (1024 * 1024);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/world-canvas.js");
        await RegenerateAsync();
    }

    private void OnSizePresetChanged(ChangeEventArgs e)
    {
        _sizePreset = e.Value?.ToString() ?? "512x320";

        var preset = SizePresets.FirstOrDefault(p => p.Key == _sizePreset);
        if (preset is not null)
        {
            _width = preset.Width;
            _height = preset.Height;
        }
    }

    private async Task RandomizeAsync()
    {
        _seed = Random.Shared.Next(int.MinValue, int.MaxValue);
        await RegenerateAsync();
    }

    private async Task SetViewAsync(MapView view)
    {
        _view = view;
        await DrawAsync();
    }

    private async Task SetZoomAsync(int zoom)
    {
        _zoom = zoom;
        await DrawAsync();
    }

    private static string ZoomLabel(int zoom) => zoom switch
    {
        -1 => "Fit",
        -2 => "Fit ½",
        _ => $"{zoom}x",
    };

    private async Task RegenerateAsync()
    {
        if (_busy) return;

        _width = Math.Clamp(_width, 16, 4096);
        _height = Math.Clamp(_height, 16, 4096);

        _busy = true;
        _busyMessage = $"Generating {_width} × {_height}…";
        _hover = null;
        StateHasChanged();

        // Yield twice so the browser actually paints the busy state before the
        // generator takes over; a single yield lands before the render completes.
        await Task.Yield();
        await Task.Delay(1);

        var options = new WorldGenerationOptions
        {
            Seed = _seed,
            Width = _width,
            Height = _height,
            Shape = _shape,
            OceanRim = _oceanRim,
            SeaLevel = _seaLevel,
            TerrainScale = _terrainScale,
            MountainStrength = _mountains,
            CoastWarp = _coastWarp,
            TransitionSoftness = _softness,
            DifficultyStrength = _difficulty,
            DifficultyCurve = _difficultyCurve,
            DifficultyWarp = _difficultyWarp,
            RiverCount = _rivers,
        };

        try
        {
            var started = System.Diagnostics.Stopwatch.StartNew();

            // Generation must not run on the WASM main thread. Blocking waits are
            // illegal there, so Parallel.For silently degrades to serial execution
            // (measured: 180 s vs 20 s for a 4096x4096 world). Task.Run moves it to
            // a pool thread where the fork/join actually parallelises, and keeps the
            // UI responsive as a bonus.
            _map = await Task.Run(() => WorldGenerator.Generate(options));
            _generationMs = started.ElapsedMilliseconds;

            _diagnostics = string.Join(" · ",
                WorldGenerator.LastTimings
                    .OrderByDescending(t => t.Milliseconds)
                    .Take(5)
                    .Select(t => $"{t.Pass} {t.Milliseconds}ms"));

            _biomeShares = _map.BiomeDistribution()
                .OrderByDescending(kv => kv.Value)
                .ToList();

            _dangerShares = _map.DangerDistribution()
                .OrderBy(kv => kv.Key)
                .ToList();
        }
        catch (OutOfMemoryException)
        {
            _map = null;
            _busyMessage = "Out of memory — try a smaller world.";
            _busy = false;
            StateHasChanged();
            return;
        }

        _busy = false;
        await DrawAsync();
    }

    private async Task DrawAsync()
    {
        if (_module is null || _map is null) return;

        // Decide how much of the map each canvas pixel represents. Anything above
        // ~1400px on an edge is downsampled; the rest is magnified.
        int stride;
        double displayScale;

        if (_zoom < 0)
        {
            int budget = _zoom == -2 ? MaxCanvasEdge / 2 : MaxCanvasEdge;
            int longest = Math.Max(_map.Width, _map.Height);
            stride = Math.Max(1, (int)Math.Ceiling(longest / (double)budget));
            displayScale = 1;
        }
        else
        {
            stride = 1;
            displayScale = _zoom;

            // Magnifying a huge map would blow past any sane canvas size, so fall
            // back to downsampling if the request cannot be honoured.
            if (Math.Max(_map.Width, _map.Height) * displayScale > MaxCanvasEdge * 4)
            {
                stride = Math.Max(1, (int)Math.Ceiling(Math.Max(_map.Width, _map.Height) / (double)MaxCanvasEdge));
                displayScale = 1;
            }
        }

        var region = new RenderRegion(0, 0, _map.Width, _map.Height, stride);

        var started = System.Diagnostics.Stopwatch.StartNew();

        // Same reasoning as generation: rasterising 16.7M tiles parallelises only
        // when it runs off the main thread.
        var pixels = await Task.Run(() => WorldRenderer.RenderRgba(_map, new RenderOptions
        {
            View = _view,
            Relief = _relief ? 1f : 0f,
            ShowDangerTint = _dangerTint,
            ShowCoastline = _coastline,
            Region = region,
        }));
        _renderMs = started.ElapsedMilliseconds;

        _stride = stride;
        _regionX = region.X;
        _regionY = region.Y;
        _displayScale = displayScale;

        using var stream = new MemoryStream(pixels);
        using var reference = new DotNetStreamReference(stream, leaveOpen: true);

        await _module.InvokeVoidAsync(
            "drawWorld", _canvas, reference, region.PixelWidth, region.PixelHeight, displayScale);

        StateHasChanged();
    }

    private void OnMouseMove(MouseEventArgs e)
    {
        if (_map is null) return;

        // Canvas pixel -> sampled pixel -> tile.
        int px = (int)(e.OffsetX / _displayScale);
        int py = (int)(e.OffsetY / _displayScale);
        int x = _regionX + px * _stride;
        int y = _regionY + py * _stride;

        if (!_map.TryGet(x, y, out var tile))
        {
            _hover = null;
            return;
        }

        _hover = tile;
        _hoverX = x;
        _hoverY = y;

        // Flip the tooltip to the other side of the cursor near the right/bottom
        // edge so it never runs off the map.
        bool flipX = px > _map.Width / (double)_stride * 0.62;
        bool flipY = py > _map.Height / (double)_stride * 0.68;

        _tooltipX = 10 + e.OffsetX + (flipX ? -276 : 18);
        _tooltipY = 10 + e.OffsetY + (flipY ? -196 : 14);
    }

    private void OnMouseLeave() => _hover = null;

    private string ElevationLabel(WorldTile tile)
    {
        float sea = _map?.Options.SeaLevel ?? 0.42f;
        return tile.Elevation < sea
            ? $"-{(tile.WaterDepth(sea) * 100f):0}% depth"
            : $"+{(tile.LandHeight(sea) * 100f):0}% height";
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try { await _module.DisposeAsync(); }
            catch (JSDisconnectedException) { }
        }
    }
}
